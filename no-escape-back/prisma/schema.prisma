// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Skill {
  id         Int         @id @default(autoincrement())
  name       String
  slug       String      @unique
  category   String
  level      Int         @default(1)
  xp         Int         @default(0)
  icon       String?
  xpSources  String
  sortOrder  Int         @default(0)
  activities Activity[]
  dailyTasks DailyTask[]
}

model Activity {
  id       Int      @id @default(autoincrement())
  skillId  Int
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  xpGained Int
  duration Int?
  note     String?
  loggedAt DateTime @default(now())
}

model DailyTask {
  id              Int       @id @default(autoincrement())
  date            String
  importance      String
  slotIndex       Int
  title           String    @default("")
  skillId         Int?
  skill           Skill?    @relation(fields: [skillId], references: [id], onDelete: SetNull)
  effortLevel     Int       @default(5)
  durationMinutes Int       @default(45)
  completed       Boolean   @default(false)
  xpAwarded       Int?
  activityId      Int?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([date, importance, slotIndex])
  @@index([date])
}

/// Immutable day archive — full board + skill tree at seal time.
model DailyLog {
  id             Int      @id @default(autoincrement())
  date           String   @unique
  sealedAt       DateTime @default(now())
  filledCount    Int
  completedCount Int
  earnedXp       Int
  projectedXp    Int
  snapshotJson   String
}
