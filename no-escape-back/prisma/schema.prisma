// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Skill {
  id                 Int                  @id @default(autoincrement())
  name               String
  slug               String               @unique
  category           String
  level              Int                  @default(1)
  xp                 Int                  @default(0)
  icon               String?
  xpSources          String
  sortOrder          Int                  @default(0)
  activities         Activity[]
  dailyTasks         DailyTask[]
  taskTemplates      DailyTaskTemplate[]
  horologiumSessions HorologiumSession[]
  levelUps           LevelUpEvent[]
  rewards            Reward[]
  habits             Habit[]
}

enum UnlockType {
  GEAR
  FEATURE
  COSMETIC
  RESOURCE
}

model Reward {
  id             Int        @id @default(autoincrement())
  skillId        Int
  skill          Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  levelReq       Int
  type           UnlockType
  label          String
  description    String
  permissionKey  String?
  wealthLevelReq Int?
  questIds       String?
  orderIndex     Int
  icon           String
  unlocked       Boolean    @default(false)
  claimedAt      DateTime?

  @@unique([skillId, levelReq, orderIndex])
  @@index([skillId])
}

model Activity {
  id       Int      @id @default(autoincrement())
  skillId  Int
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  xpGained Int
  duration Int?
  note     String?
  loggedAt DateTime @default(now())
}

model DailyTask {
  id              Int       @id @default(autoincrement())
  date            String
  importance      String
  slotIndex       Int
  title           String    @default("")
  skillId         Int?
  skill           Skill?    @relation(fields: [skillId], references: [id], onDelete: SetNull)
  habitId         Int?
  habit           Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)
  /// When set, completion awards this XP instead of the importance formula.
  fixedXp         Int?
  effortLevel     Int       @default(5)
  durationMinutes Int       @default(45)
  /// Work time from Horologium (rest and pause excluded).
  elapsedMs       BigInt    @default(0)
  completed       Boolean   @default(false)
  xpAwarded       Int?
  activityId      Int?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([date, importance, slotIndex])
  @@index([date])
  @@index([habitId])
}

/// Reusable daily presets (not habits) — quick-fill for repetitive chores.
model DailyTaskTemplate {
  id              Int      @id @default(autoincrement())
  name            String
  icon            String?
  skillId         Int
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  fixedXp         Int
  effortLevel     Int      @default(5)
  durationMinutes Int      @default(30)
  sortOrder       Int      @default(0)
  createdByUser   Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([skillId])
  @@index([active])
}

/// Immutable day archive — full board + skill tree at seal time.
model DailyLog {
  id             Int      @id @default(autoincrement())
  date           String   @unique
  sealedAt       DateTime @default(now())
  filledCount    Int
  completedCount Int
  earnedXp       Int
  projectedXp    Int
  snapshotJson   String
}

/// Recorded whenever a skill gains one or more levels.
model LevelUpEvent {
  id           Int      @id @default(autoincrement())
  skillId      Int
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  fromLevel    Int
  toLevel      Int
  levelsGained Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([skillId])
}

/// Horologium work log — Focus per block, Discipline on sessio complete.
model HorologiumSession {
  id                   Int      @id @default(autoincrement())
  date                 String
  workMinutes          Int
  restMinutes          Int
  iterations           Int
  durationMinutes      Int
  presetId             String?
  skillId              Int?
  skill                Skill?   @relation(fields: [skillId], references: [id], onDelete: SetNull)
  xpAwarded            Int
  activityId           Int?
  note                 String?
  completedAt          DateTime @default(now())
  /// block | goal | abandon | task | task_early
  outcome              String   @default("complete")
  endedEarly           Boolean  @default(false)
  elapsedMinutes       Int?
  questRunId           Int?
  taskLabel            String?
  focusXpAwarded       Int      @default(0)
  disciplineXpAwarded  Int      @default(0)
  startedAt            DateTime?
  watchName            String?
  /// JSON array of { slug, name, icon, xp }
  skillXpJson          String?

  @@index([date])
  @@index([completedAt])
  @@index([questRunId])
}

/// Count-up project stopwatch — work time only, can span days.
model HorologiumWatch {
  id            Int       @id @default(autoincrement())
  name          String
  status        String    @default("ACTIVE")
  elapsedMs     BigInt    @default(0)
  running       Boolean   @default(false)
  startedAt     DateTime  @default(now())
  lastStartedAt DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

/// Singleton player profile (titles, informative status).
model Character {
  id        Int      @id @default(1)
  title     String   @default("Peasant")
  nickname  String   @default("")
  timezone  String   @default("Europe/Tallinn")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// App feature gates (e.g. Habitus / streaks).
model FeatureUnlock {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  unlocked   Boolean   @default(false)
  unlockedAt DateTime?
}

/// Catalog + custom IRL goal quests.
model Quest {
  id             Int        @id @default(autoincrement())
  slug           String     @unique
  name           String
  tier           String     @default("NOVICE")
  summary        String
  description    String
  /// Filename under /assets/images/quests/ (e.g. "1st-quest.png")
  coverImage     String?
  skillSlug      String?
  durationDays   Int?
  kind           String     @default("GENERIC")
  rules          String?
  stakes         String?
  howToWin       String?
  destination    String?
  journeyLabel   String?
  journeyNote    String?
  /// Days per week the journey check-in is expected (1–7).
  commitmentLevel Int       @default(7)
  /// Total XP awarded on completion, split by skillWeightsJson.
  totalXp         Int       @default(0)
  /// [{ "slug": "cook", "weight": 7 }, …] — weights must sum to 10 when any skills are set.
  skillWeightsJson String?
  skillReqsJson  String?
  unlockReqsJson String?
  questReqsJson  String?
  rewardJson     String?
  xpPlanJson     String?
  createdByUser  Boolean    @default(false)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  runs           QuestRun[]
  subtasks       QuestSubtask[]
}

model QuestSubtask {
  id            Int                      @id @default(autoincrement())
  questId       Int
  quest         Quest                    @relation(fields: [questId], references: [id], onDelete: Cascade)
  title         String
  sortOrder     Int                      @default(0)
  /// When true, daily journey check-in stays locked until this subtask is done.
  gatesJourney  Boolean                  @default(false)
  completions   QuestSubtaskCompletion[]

  @@index([questId])
}

model QuestRun {
  id               Int                      @id @default(autoincrement())
  questId          Int
  quest            Quest                    @relation(fields: [questId], references: [id], onDelete: Cascade)
  status           String                   @default("ACTIVE")
  streakCount      Int                      @default(0)
  bestStreak       Int                      @default(0)
  startedAt        DateTime                 @default(now())
  completedAt      DateTime?
  lastLogDate      String?
  destinationDone  Boolean                  @default(false)
  logs             QuestDayLog[]
  journeyLogs      QuestJourneyLog[]
  subtaskCompletions QuestSubtaskCompletion[]

  @@index([status])
  @@index([questId])
}

model QuestDayLog {
  id        Int      @id @default(autoincrement())
  runId     Int
  run       QuestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  date      String
  result    String
  xpAwarded Int      @default(0)
  note      String?
  createdAt DateTime @default(now())

  @@unique([runId, date])
  @@index([date])
}

model QuestJourneyLog {
  id        Int      @id @default(autoincrement())
  runId     Int
  run       QuestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  date      String
  note      String?
  createdAt DateTime @default(now())

  @@unique([runId, date])
  @@index([date])
}

model QuestSubtaskCompletion {
  id          Int          @id @default(autoincrement())
  runId       Int
  run         QuestRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  subtaskId   Int
  subtask     QuestSubtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  completedAt DateTime     @default(now())
  /// False while Horologium is still tracking this subtask.
  done        Boolean      @default(true)
  elapsedMs   BigInt       @default(0)

  @@unique([runId, subtaskId])
  @@index([runId])
}

model Habit {
  id          Int               @id @default(autoincrement())
  name        String
  icon        String?
  skillId     Int?
  skill       Skill?            @relation(fields: [skillId], references: [id], onDelete: SetNull)
  cadence     String            @default("DAILY")
  everyNDays  Int               @default(1)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  completions HabitCompletion[]
  dailyTasks  DailyTask[]
}

model HabitCompletion {
  id          Int      @id @default(autoincrement())
  habitId     Int
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date        String
  source      String   @default("manual")
  dailyTaskId Int?
  createdAt   DateTime @default(now())

  @@unique([habitId, date])
  @@index([date])
}
