# Local development only.
#   cp .env.example .env
#
# Safe to commit. These URLs are the default Supabase Docker database
# started with `npm run db:up` from the repo root. They are not production.
#
# Hosted Supabase credentials stay in the server copy of .env
# (~/dev/noescape/no-escape-back/.env). That file is gitignored, so a deploy
# checkout keeps it. Do not commit that URL, password, or project ref.
#
# On the server, Prisma needs the direct Postgres connection (port 5432).
# The transaction pooler (port 6543) breaks Prisma prepared statements and
# interactive transactions. The API rewrites 6543 to 5432 at startup.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# The running API caps this pool at 2 connections (see PrismaService).
# Schema updates use `npm run db:push` here and `prisma db push` on the runner.

# ng serve calls http://localhost:3000. See NoEscape-UI/src/app/core/api.config.ts.
# Production does not read this file. PM2 sets PORT=8084 in ecosystem.config.json.
PORT=3000
